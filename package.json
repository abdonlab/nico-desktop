{
  "name": "nico-desktop",
  "version": "1.2.1",
  "description": "NICO — avatar de escritorio con IA (UMSNH). Lobo neón flotante con chat Gemini integrado.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "indexar": "node indexar.js",
    "dist": "electron-builder"
  },
  "author": "Abdón / AI Lab UMSNH",
  "license": "MIT",
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "mx.umsnh.nico",
    "productName": "NICO",
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "rag.js",
      "conocimiento.json",
      "src/**/*",
      "!nico.config.js"
    ],
    "extraResources": [
      {
        "from": "nico.config.js",
        "to": "nico.config.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NICO",
      "artifactName": "NICO-Setup.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "gatekeeperAssess": false
    }
  }
}
